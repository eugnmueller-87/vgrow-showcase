# Copy this file to ~/.vgrow.env (Windows: %USERPROFILE%\.vgrow.env), outside the repository,
# and keep it readable only by you. Details: docs/getting-started.md

# Your VIVOSUN account. Use an email/password login: a Google sign-in alone gives the service no password.
VIVOSUN_EMAIL=your-account-email
VIVOSUN_PASSWORD=your-account-password

# Optional
# VGROW_LANG=en
# GROWCAM_IP=192.168.1.50
# ECOWITT_IP=192.168.1.51
# NTFY_SERVER=https://ntfy.sh
# VGROW_NTFY_TOPIC=pick-a-long-random-topic
# OLLAMA_URL=http://127.0.0.1:11434
# HANK_MODEL=gemma4:12b
# HANK_EMBED_MODEL=granite-embedding:278m
