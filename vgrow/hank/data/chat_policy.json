  "blocked_source_hosts": {
    "about": "Seed shops and retailers: a source on one of these hosts is shown as text without a link (decision D3, addendum N5: 'Händler und Samenbanken erscheinen als Text ohne Link'). Since the acceptance of 23.10.2026 also the retailers the cards themselves mark as such (Trimleaf 'Händler', Johnny's Selected Seeds 'seed retailer', Hydrobuilder, Amazon) and 420seedz.de, as a precaution: the card calls it the soil's maker, its name suggests a seed shop, not checked online. Eugen decides (D3).",
    "hosts": ["zamnesia.com", "hanfgartenshop.de", "420seedz.de", "hydrobuilder.com", "trimleaf.com", "johnnyseeds.com", "amazon.de", "amazon.com", "hanfgarten.at", "barneysfarm.de", "barneysfarm.com"]
  },
  "vendor_names": {
    "about": "Seed shop names in running text are replaced (decision D3, wording to be approved under D5). The rules first, in order (regular expressions, case-insensitive, per answer language; they keep the grammar: 'laut Hanfgarten' becomes 'laut einem Samenhändler', not 'laut ein Samenhändler'), then the plain names as the fallback.",
    "rules": [
      {"lang": "de", "pattern": "\\blaut (Hanfgarten|Zamnesia)( Seeds)?\\b", "replace": "laut einem Samenhändler"},
      {"lang": "de", "pattern": "\\b(der|die|das) gleichnamigen (Hanfgarten|Zamnesia)-Sorte\\b", "replace": "\\1 gleichnamigen Sorte eines anderen Samenhändlers"},
      {"lang": "de", "pattern": "\\b(Hanfgarten|Zamnesia)-(\\w+)", "replace": "\\2 eines Samenhändlers"},
      {"lang": "de", "pattern": "\\b(Hanfgarten|Zamnesia)( Seeds)? (\\d)", "replace": "ein anderer Samenhändler nennt \\3"},
      {"lang": "de", "pattern": "\\b(Hanfgartens|Zamnesias)\\b", "replace": "eines Samenhändlers"},
      {"lang": "en", "pattern": "\\baccording to (Hanfgarten|Zamnesia)( Seeds)?\\b", "replace": "according to a seed shop"},
      {"lang": "en", "pattern": "\\bthe (Hanfgarten|Zamnesia)( Seeds)? strain of the same name\\b", "replace": "the strain of the same name from another seed shop"},
      {"lang": "en", "pattern": "\\bthe (Hanfgarten|Zamnesia)( Seeds)? (\\w+ \\w+|\\w+)\\b(?= \\()", "replace": "the \\3 of a seed shop"},
      {"lang": "en", "pattern": "\\b(Hanfgarten|Zamnesia)( Seeds)? (\\d)", "replace": "another seed shop gives \\3"},
      {"lang": "en", "pattern": "\\b(Hanfgarten's|Zamnesia's)\\b", "replace": "a seed shop's"},
      {"lang": "de", "pattern": "\\b(Hanfgarten|Zamnesia) Seeds\\b", "replace": "ein Samenhändler"},
      {"lang": "en", "pattern": "\\b(Hanfgarten|Zamnesia) Seeds\\b", "replace": "a seed shop"}
    ],
    "names": {
      "Zamnesia": {"de": "ein Samenhändler", "en": "a seed shop"},
      "Hanfgarten": {"de": "ein Samenhändler", "en": "a seed shop"}
    }
  }
